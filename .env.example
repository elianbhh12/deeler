# Copiar este archivo a ".env" y completar con los valores reales.
# El ".env" real NUNCA se sube a ningún repositorio ni se comparte (tiene el PAT).

# Organizacion y proyecto en Azure DevOps
ADO_ORG=mi-organizacion
ADO_PROJECT=mi-proyecto
ADO_TEAM=mi-equipo
ADO_AREA=mi-proyecto\\Mi Area

# Personal Access Token de Azure DevOps (permisos de lectura sobre Work Items)
ADO_PAT=

# Sprint por defecto al abrir la app (ajustar cada sprint nuevo)
ITERATION_PATH=mi-proyecto\\Mi Area\\Sprint 253

# Carpeta local donde se descargan y analizan las HU
# (mas adelante puede apuntar a una carpeta sincronizada con SharePoint)
ROOT_FOLDER=C:\Backlog_Dealer

# Nombre del dealer/ingeniero asignado, para filtrar HU en ADO
DEALER_NAME=

# Ruta al JSON de credenciales temporales de AWS (mismo formato que usa
# cargaaws.py: aws_access_key_id, aws_secret_access_key, aws_session_token,
# region_name). No hace falta definirla: por default apunta a
# "aws_credentials.json" en la raíz del proyecto (gitignored). Completar acá
# solo para usar otra ubicación — alcanza con la ruta relativa a la raíz del
# proyecto, no hace falta la ruta absoluta completa.
# AWS_CRED_FILE=

# Nombres de las tablas DynamoDB por componente y ambiente. Opcionales: si se
# dejan vacíos, se usan los nombres actuales del banco (ver core/config.py).
# Descomentar y editar solo si cambia el nombre de alguna tabla.
# AWS_TABLA_AID_QA=nu0087001-aid-r2-qa-dynamo-config-control
# AWS_TABLA_TA_QA=nu0600001-plataforma-ia-qa-text-analyzer-table
# AWS_TABLA_UDZ_QA=nu6490001-udz-qa-events-manager-table
# AWS_TABLA_AID_PDN=nu0087001-aid-r2-pdn-dynamo-config-control
# AWS_TABLA_TA_PDN=nu0600001-plataforma-ia-pdn-text-analyzer-table
# AWS_TABLA_UDZ_PDN=nu6490001-udz-pdnevents-manager-table
