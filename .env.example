# Copiar este archivo a ".env" y completar con los valores reales.
# El ".env" real NUNCA se sube a ningún repositorio ni se comparte (tiene el PAT).

# Organizacion y proyecto en Azure DevOps
ADO_ORG=mi-organizacion
ADO_PROJECT=mi-proyecto
ADO_TEAM=mi-equipo
ADO_AREA=mi-proyecto\\Mi Area

# Personal Access Token de Azure DevOps (permisos de lectura sobre Work Items)
ADO_PAT=

# Sprint por defecto al abrir la app (ajustar cada sprint nuevo)
ITERATION_PATH=mi-proyecto\\Mi Area\\Sprint 253

# Carpeta local donde se descargan y analizan las HU
# (mas adelante puede apuntar a una carpeta sincronizada con SharePoint)
ROOT_FOLDER=C:\Backlog_Dealer

# Nombre del dealer/ingeniero asignado, para filtrar HU en ADO
DEALER_NAME=
